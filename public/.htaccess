# ============================================================
# CodeIgniter 4 - Apache .htaccess
# Project: web-pakanjadi-report
# Environment: Laragon / Apache
# ============================================================

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On

    # --------------------------------------------------------
    # Rewrite request ke front controller CodeIgniter
    # --------------------------------------------------------

    # Jika request bukan file atau direktori yang benar-benar ada,
    # arahkan ke index.php untuk diproses oleh CodeIgniter.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]

    # --------------------------------------------------------
    # Pastikan Authorization header diteruskan
    # --------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ------------------------------------------------------------
# Fallback jika mod_rewrite tidak aktif
# ------------------------------------------------------------
<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.php
</IfModule>

# Disable server signature
ServerSignature Off